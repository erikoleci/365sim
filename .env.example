# Backend (server/) config
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
ODDS_API_KEY=your_theoddsapi_key_here
# Optional supplementary LIVE-score source — https://my.sportmonks.com/
SPORTMONKS_KEY=your_sportmonks_api_token_here

# LondonPro365 data provider (server/london365.js): matches, markets,
# coefficients, and live in-play updates. Enabled by default.
# Use only with proper authorization from the API owner.
LONDON365_ENABLED=1
LONDON365_API=https://eccoplay365.com
LONDON365_SPORTS=1
LONDON365_LEAGUES=0
LONDON365_FULL=1
LONDON365_LIVE_INTERVAL_MS=30000
LONDON365_IMPORT_THROTTLE_MS=600000
# Native Socket.IO live feed (sub-second odds/score updates). REST polling
# above stays on as a safety net if the socket drops. Set to 0 to disable.
LONDON365_SOCKET=https://ecco.socketi355.com:1440
LONDON365_SOCKET_ENABLED=1
# PostgreSQL connection string — e.g. a free database from neon.tech or supabase.com.
# Local dev example: postgresql://postgres:yourpassword@localhost:5432/sim365
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://365sim.example.com,https://staging.365sim.example.com
# Leave unset only for local dev where frontend and API share an origin.
FRONTEND_ORIGIN=https://your-frontend-domain.example.com

# Frontend (Vite) config — used by services/geminiService.ts fallback, optional
API_KEY=your_gemini_api_key_here
