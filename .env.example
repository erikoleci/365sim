# Backend (server/) config
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string

# LondonPro365 data provider (server/london365.js): matches, markets,
# coefficients, and live in-play updates. Enabled by default.
# Use only with proper authorization from the API owner.
LONDON365_ENABLED=1
LONDON365_API=https://eccoplay365.com
# Catalogue (explicit; these ARE the defaults). Soccer only, five countries + the
# International bucket narrowed to UEFA Champions/Europa/Conference League, Nations
# League and other UEFA/Euro competitions. MAJOR_ONLY=1 drops youth/reserve/women's/
# amateur/friendly and regional lower tiers. Use ONLY_COUNTRIES='*' to import the
# whole world (opt-in). FULL only controls detail depth for ACCEPTED leagues.
LONDON365_SPORTS=1
LONDON365_ONLY_COUNTRIES=England,France,Spain,Italy,Germany
LONDON365_MAJOR_ONLY=1
LONDON365_LEAGUES=0
LONDON365_FULL=1
LONDON365_LIVE_INTERVAL_MS=30000
LONDON365_IMPORT_THROTTLE_MS=600000
# Native Socket.IO live feed (sub-second odds/score updates). REST polling
# above stays on as a safety net if the socket drops. Set to 0 to disable.
LONDON365_SOCKET=https://ecco.socketi355.com:1440
LONDON365_SOCKET_ENABLED=1
# PostgreSQL connection string — e.g. a free database from neon.tech or supabase.com.
# Local dev example: postgresql://postgres:yourpassword@localhost:5432/sim365
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://365sim.example.com,https://staging.365sim.example.com
# Leave unset only for local dev where frontend and API share an origin.
FRONTEND_ORIGIN=https://your-frontend-domain.example.com

# Set ONLY on an API-only deploy (Build Command skips "npm run build", so
# no dist/ exists here for express.static to serve) -- points anyone who
# lands on a bare page request at this URL to where the frontend actually
# lives instead of a 404/500. Recommended split for a free-tier host
# metered on outbound bandwidth (e.g. Render's Hobby workspace, 5 GB/mo):
# host the static JS/CSS bundle somewhere with generous free bandwidth and
# no such cap (Netlify, Cloudflare Pages, GitHub Pages), and keep this
# service answering ONLY /api and /ws -- JSON + WebSocket traffic is far
# smaller than re-serving the whole bundle on every visit.
PUBLIC_FRONTEND_URL=https://your-frontend.netlify.app

# Frontend (Vite) config — used by services/geminiService.ts fallback, optional
API_KEY=your_gemini_api_key_here

# ---- Neon usage reduction (all optional; defaults shown are the recommended ones) ----
# (Catalogue variables are in the LONDON365 block near the top of this file.)
# Optional regexes (case-insensitive). International extras to KEEP (default none), and extra league names to DROP.
#   LONDON365_INTERNATIONAL_EXTRA=\b(fifa|world cup)\b
#   LONDON365_EXCLUDE_LEAGUE_PATTERN=\b(league two|3\. liga)\b
# Skip UPSERTs that would change nothing; still write a heartbeat this often (ms, max 300000,
# must stay under the 8 min stale-live threshold).
#   LONDON365_SKIP_UNCHANGED_WRITES=1
#   LONDON365_WRITE_HEARTBEAT_MS=240000
# odds_history: all | bets_only | off  (bets_only = only matches with a PENDING bet)
#   ODDS_HISTORY_MODE=bets_only
# Throttle for import resume-cursor writes to kv_store (ms) and the live-row cache TTL (ms).
#   LONDON365_CURSOR_WRITE_MS=30000
#   LONDON365_LIVE_ROW_TTL_MS=20000
# Per-tick "[live] EID=..." log line (very noisy). Off by default.
#   LONDON365_GAMEDETAILS_TICK_LOG=1
# [feed-stats] log interval (ms) and disk-pressure threshold (MB) — set the latter to ~80% of your Neon storage cap.
#   FEED_STATS_LOG_INTERVAL_MS=600000
#   DB_DISK_PRESSURE_MB=400
