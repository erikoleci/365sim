# Kopjoje si .env.prod në server dhe plotësoje. MOS e ngarko në GitHub.
# Domeni që do të tregojë te IP e serverit (A record), p.sh. sim.shembull.com
DOMAIN=sim.shembull.com
POSTGRES_PASSWORD=ndrysho-me-nje-fjalekalim-te-gjate
JWT_SECRET=ndrysho-me-nje-varg-te-gjate-te-rastesishem
# Fjalëkalimi i ri i admin-it (zëvendëson admin/admin në nisjen e parë)
ADMIN_PASSWORD=ndrysho-fjalekalimin-e-adminit
# Fjalëkalimi i ri i agjentit "root" (nëse e lë bosh, mbetet root/root -- jo e sigurt!)
AGENT_PASSWORD=
