# Kopjoje si .env.local dhe plotësoje. Mos e ngarko në GitHub.
POSTGRES_PASSWORD=ndrysho-me-nje-fjalekalim-te-gjate
JWT_SECRET=ndrysho-me-nje-varg-te-gjate-te-rastesishem
# Fjalëkalimi i ri i admin-it (zëvendëson admin/admin në nisjen e parë)
ADMIN_PASSWORD=ndrysho-fjalekalimin-e-adminit
# Opsionale: fjalëkalimi i ri i agjentit "root" (nëse e lë bosh, mbetet root/root -- jo e sigurt!)
AGENT_PASSWORD=
# Ku të vijë linku sa herë ndizet PC-ja (zgjidh njërën ose të dyja):
# 1) ntfy.sh -- instalo aplikacionin "ntfy" në telefon dhe abonohu te kjo "temë" (zgjidh emër të gjatë të rastësishëm)
NTFY_TOPIC=sim365-vendos-nje-emer-te-rastesishem
# 2) Telegram -- krijo bot me @BotFather, merr chat id (p.sh. nga @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
