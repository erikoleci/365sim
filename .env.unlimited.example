# ---- LOCAL "NO LIMITS" profile: copy these lines into your .env ----
# Do NOT set NODE_ENV=production locally (that turns the API rate limiters on).

# Catalogue: every country, every league, no filtering
LONDON365_ONLY_COUNTRIES=*
LONDON365_MAJOR_ONLY=0
LONDON365_EXCLUDE_SECOND_TIER=0
# Empty (not unset) = exclude no country. Unset would default to Brazil.
LONDON365_EXCLUDE_COUNTRIES=
LONDON365_LEAGUES=0
LONDON365_FULL=1

# Live sync: more parallel lanes (it also grows by itself ~1 lane per 12 games)
LONDON365_LIVE_CONCURRENCY=20
LONDON365_LIVE_CONCURRENCY_MAX=60
# DB pool must be >= live lanes. Local Postgres allows 100 connections by default.
PG_POOL_MAX=40

# /api/matches: pages of 200 rows -> 1000 pages = 200,000 rows
MATCHES_PAGE_HARD_CAP=1000

# Keep every live match for as long as the feed has it (default 4h is a safety net
# that drops matches the feed abandoned; 24 is the most generous sensible value)
LIVE_MAX_AGE_HOURS=24
